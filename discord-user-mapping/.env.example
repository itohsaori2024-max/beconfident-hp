# =====================================================================
# Discord User Mapping — 環境変数サンプル
# このファイルを `.env.local` にコピーして値を設定してください。
# `.env.local` は .gitignore 済みでコミットされません。
# =====================================================================

# ---------------------------------------------------------------------
# Discord OAuth2
# https://discord.com/developers/applications で取得
#   - Application を作成
#   - OAuth2 > Redirect に下記 DISCORD_REDIRECT_URI を登録
# ---------------------------------------------------------------------
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
# 開発時は http://localhost:3000/api/auth/discord/callback
# 本番時は https://<your-domain>/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord Embedded App SDK（クライアント側で使用）。CLIENT_ID と同値。
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_application_client_id

# ---------------------------------------------------------------------
# Supabase
# https://app.supabase.com > Project Settings > API で取得
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# service_role キーはサーバー専用（RLS をバイパスする）。絶対にクライアントへ出さない。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------------------------------------------------------
# アプリ設定
# ---------------------------------------------------------------------
# ベース URL（OAuth リダイレクト後の遷移などに使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# セッション Cookie の署名に使う秘密鍵（32文字以上のランダム文字列）
# 生成例: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_secret_string
